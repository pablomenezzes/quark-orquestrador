{
  "regions": ["gru1"],
  "functions": {
    "api/studio.ts": { "includeFiles": "studio/public/**", "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/experimentos", "schedule": "0 11 * * *" }

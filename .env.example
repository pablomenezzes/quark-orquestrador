# Copie para .env.test e preencha. NUNCA commitar valores reais.
# Nesta fase (1-3) so existe o projeto Supabase de TESTES.

# Projeto Supabase de TESTES
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Trava de seguranca: se SUPABASE_URL contiver algum destes trechos (separados por virgula),
# o codigo se recusa a iniciar. Coloque aqui o ref do projeto de PRODUCAO.
SUPABASE_PROD_REF_BLOCKLIST=

# Modo sombra: fixo em true. Nao existe caminho de execucao real nesta fase.
SHADOW_MODE=true

# Tokens em texto puro das fontes, SOMENTE para gerar o token_hash do seed de testes.
# No banco ficam apenas os hashes.
SOURCE_TOKEN_LP_VERCEL_TESTE=
SOURCE_TOKEN_ELEMENTOR_TESTE=


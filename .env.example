# Copie para .env.local e preencha. NUNCA commitar valores reais.
# Projeto Supabase unico (Sao Paulo). O schema public NAO e usado pelo orquestrador.

# Project Settings -> API -> Project URL
SUPABASE_URL=
# Project Settings -> API Keys -> service_role (SECRETA, so no servidor). Edite voce mesmo, nunca cole em chat.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> General -> Reference ID (tambem aparece na URL do painel)
SUPABASE_PROJECT_REF=
# Connect -> Connection string -> Session pooler (porta 5432), com a senha do banco.
# Usada pelos testes de integracao (transacao com rollback) e pelo dump (scripts/dump.ps1).
SUPABASE_DB_URL=

# Conexao do ENDPOINT PUBLICO (Vercel): papel de privilegio minimo orq_ingest, NUNCA o postgres.
# Gerada e gravada por: node scripts/set-ingest-password.mjs --apply   (depois da migration 0003)
INGEST_DB_URL=
# Sal secreto dos contadores de limite de requisicoes (o IP nunca vai ao banco em claro). Gerado pelo mesmo script.
RATE_LIMIT_SALT=

# Modo sombra: fixo em true. Nao existe caminho de execucao real nesta fase.
SHADOW_MODE=true

# Tokens em texto puro das fontes, SOMENTE para gerar o token_hash ao registrar a fonte.
# No banco ficam apenas os hashes.
SOURCE_TOKEN_LP_VERCEL=
SOURCE_TOKEN_ELEMENTOR=

# --- Fases futuras (nao usar nesta sessao) ---
# UMBLER_API_TOKEN=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Data Hub do Pipedrive (somente leitura) ---
# Endereco da conta: so o nome (ex.: suaempresa) ou suaempresa.pipedrive.com. Nao e secreto.
PIPEDRIVE_DOMAIN=
# Token do Pipedrive. NAO digite aqui nem no chat: rode  node scripts/save-secret.mjs PIPEDRIVE_API_TOKEN  (tela escondida).
PIPEDRIVE_API_TOKEN=
# Conexoes dos papeis do Data Hub (geradas por  node scripts/set-role-password.mjs --role orq_sync --apply  e  --role orq_panel).
SYNC_DB_URL=
PANEL_DB_URL=
